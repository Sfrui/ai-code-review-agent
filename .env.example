# ============================================================
# 环境变量配置模板
# 复制到 apps/server/.env 并填入实际值
# ============================================================

# Server
MONGODB_URI=mongodb://localhost:27017/ai-code-review
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ============================================================
# LLM 配置
# ============================================================
#
# 国内提供商（推荐）：
#   deepseek      - DeepSeek (deepseek-chat)         → https://platform.deepseek.com
#   moonshot      - Kimi (moonshot-v1-8k)             → https://platform.moonshot.cn
#   zhipu         - 智谱 GLM (glm-4-flash)            → https://open.bigmodel.cn
#   qwen          - 通义千问 (qwen-plus)               → https://dashscope.console.aliyun.com
#   doubao        - 豆包 (doubao-pro-4k)              → https://console.volcengine.com
#   yi            - 零一万物 (yi-large)                → https://platform.lingyiwanwu.com
#
# 国际提供商：
#   openai        - OpenAI (gpt-4o)                   → https://platform.openai.com
#   anthropic     - Anthropic (claude-sonnet-4-20250514) → https://console.anthropic.com
#
# 本地模型：
#   ollama        - 本地部署 (qwen2.5:7b)             → https://ollama.com
#

LLM_PROVIDER=deepseek

# API Key（ollama 可不填）
# 获取地址取决于你的提供商（见上方链接）
LLM_API_KEY=sk-your-api-key-here

# 模型名称（留空则使用提供商默认模型）
LLM_MODEL=deepseek-chat

# 自定义 API 地址（可选，用于代理或自部署）
# LLM_BASE_URL=https://api.deepseek.com/v1

# 温度 (0-2, 越低越确定性, 推荐 0.1)
LLM_TEMPERATURE=0.1

# 最大 token 数
LLM_MAX_TOKENS=4096

# 超时时间 (毫秒)
LLM_TIMEOUT=60000
